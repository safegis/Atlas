# Copy to .env and fill in (never commit .env)

# --- LLM (chat) ---
OLLAMA_MODEL=gemma
# OpenAI-compatible chat base (default for OllamaWrapper)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Ollama native API (embeddings for RAG) ---
OLLAMA_HOST=http://127.0.0.1:11434
# Pull once: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Optional: Exa web search ---
# EXA_API_KEY=

# --- Qdrant (RAG) — set URL to enable ---
# Cloud: HTTPS URL, no trailing slash
# QDRANT_URL=https://xxxx.aws.cloud.qdrant.io
# QDRANT_API_KEY=your-api-key
# QDRANT_COLLECTION=atlas_rag
# Only if your collection uses a *named* vector (see Qdrant collection config). Leave unset for
# the default single vector. Setting a wrong name causes upsert/search errors; Atlas ignores this
# when stored points use the default unnamed vector.
# QDRANT_VECTOR_NAME=dense
# RAG_ENABLED=true
# Image upload for RAG uses OCR: install Tesseract (e.g. brew install tesseract) for PNG/JPG text extraction.
# RAG_TOP_K=5
# RAG_CHUNK_CHARS=1200
# RAG_CHUNK_OVERLAP=180
# Optional cosine threshold (omit to disable)
# RAG_SCORE_THRESHOLD=0.25
# If collection already exists with wrong size, set explicitly:
# RAG_VECTOR_SIZE=768
